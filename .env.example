# ==============================================================================
# OpenRouter AI
# ==============================================================================
# Chiave da https://openrouter.ai/keys (inizia con sk-or-v1-)
OPENROUTER_API_KEY=""
# Modello usato per le decisioni (default: openrouter/free).
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_MAX_ATTEMPTS="3"

# ==============================================================================
# Wallet su Base
# ==============================================================================
WALLET_ADDRESS="0x..."
# Chiave privata del wallet: NON committarla mai.
# Usa un wallet dedicato al bot, con dentro solo il capitale che puoi perdere.
PRIVATE_KEY=""
# RPC di Base (Alchemy, QuickNode, Infura o il pubblico https://mainnet.base.org)
BASE_RPC_URL="https://mainnet.base.org"

# ==============================================================================
# Modalita'
# ==============================================================================
# true = il ciclo gira ma NON firma nessuna transazione. Parti sempre da qui.
DRY_RUN="true"
# Paper: portafoglio virtuale che matura l'APY reale dei pool. Implica DRY_RUN.
PAPER_TRADING="false"
PAPER_START_USDC="1000"
PAPER_START_ETH="0.01"
PAPER_GAS_USD="0.02"

# ==============================================================================
# Cosa depositare
# ==============================================================================
# Asset che il bot puo' depositare: USDC, WETH, CBBTC (separati da virgola).
# Default solo USDC: nessun rischio di prezzo, conta solo il rendimento.
# Con WETH/CBBTC il bot compra l'asset via Uniswap V3 quando serve.
DEPOSIT_ASSETS="USDC"
# Protocolli ammessi (slug DefiLlama)
PROTOCOL_ALLOWLIST="aave-v3,compound-v3,morpho-blue,morpho-v1,moonwell-lending,fluid-lending,euler-v2,spark-savings,seamless-protocol"

# ==============================================================================
# Screening dei pool
# ==============================================================================
SCREEN_MIN_TVL_USD="1000000"
SCREEN_MIN_APY="1"
# Sopra questo APY e' quasi sempre emissione o un dato sbagliato
SCREEN_MAX_APY="40"
SCREEN_MIN_HISTORY_DAYS="14"
# Scarta i pool in cui le emissioni sono oltre questa quota del rendimento
SCREEN_MAX_REWARD_SHARE="0.7"
SCREEN_MAX_CANDIDATES="15"
SCREEN_CACHE_SECONDS="1800"
# Peso delle ricompense in token nel confronto (non vengono reclamate in automatico)
REWARD_APY_WEIGHT="0.5"
# Id DefiLlama o indirizzi di vault, separati da virgola
POOL_BLOCKLIST=""
# Considerati anche se il protocollo non e' in allowlist (gli altri filtri restano)
POOL_WATCHLIST=""

# ==============================================================================
# Limiti di rischio
# ==============================================================================
MAX_POOL_PCT="0.40"
MAX_PROTOCOL_PCT="0.60"
MAX_POSITIONS="4"
MIN_DEPOSIT_USD="10"
MAX_DEPOSIT_USD="2500"
# Anti-churn
MIN_APY_IMPROVEMENT="1.0"
MIN_HOLD_HOURS="24"
MAX_BREAKEVEN_DAYS="14"
# Uscita automatica se il TVL del pool crolla rispetto all'ingresso
AUTO_RISK_EXITS="true"
EXIT_TVL_DROP_PCT="40"

# ==============================================================================
# Looping Lending (Leveraged Staking Yield)
# ==============================================================================
ENABLE_LOOPING="true"
LOOP_MAX_LEVERAGE="2.2"
LOOP_TARGET_HEALTH_FACTOR="1.55"
LOOP_MIN_HEALTH_FACTOR="1.30"
LOOP_MIN_NET_APY="3.0"
LOOP_BORROW_ASSET="WETH"

# ==============================================================================
# Sicurezza operativa
# ==============================================================================
MIN_ETH_RESERVE="0.001"
MAX_SLIPPAGE_BPS="100"
DEFAULT_SLIPPAGE_BPS="50"
MAX_GAS_PRICE_GWEI="0.5"
EST_TX_COST_USD="0.05"

# ==============================================================================
# Auto-refuel USDC da ETH
# ==============================================================================
# Se USDC e' sotto soglia ma il wallet possiede ETH, converte in automatico
# l'ETH in eccesso in USDC tramite Uniswap V3, preservando la riserva per il gas.
AUTO_SWAP_ETH_TO_USDC="true"
ETH_GAS_RESERVE="0.003"
MIN_ETH_SWAP_AMOUNT="0.002"
USDC_AUTO_SWAP_THRESHOLD="5.0"

# ==============================================================================
# Telegram (opzionale)
# ==============================================================================
TELEGRAM_BOT_TOKEN=""
# I comandi sono accettati solo da questa chat
TELEGRAM_CHAT_ID=""

# ==============================================================================
# Runtime
# ==============================================================================
PORT="3000"
# Intervallo fra i cicli: il rendimento cambia lentamente, un'ora basta
TRADING_INTERVAL="3600"
# Abilita il pulsante "Esegui ciclo ora" della dashboard (vuoto = disattivato)
DASHBOARD_RUN_TOKEN=""
# Avviso "ricarica il wallet" in dashboard e su Telegram quando l'ETH per il
# gas scende sotto questa soglia (default 0.002); sotto MIN_ETH_RESERVE
# la dashboard segna "ricarica ora"
# GAS_WARN_ETH=""
# Percorsi dello stato. Lasciali vuoti: il bot usa /app/data da solo quando
# quella cartella esiste (volume persistente CapRover/Docker).
# SQLITE_DB_PATH="/app/data/yield_agent.db"
# POSITIONS_PATH="/app/data/positions.json"
